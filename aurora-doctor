#!/usr/bin/env bash
# Aurora Doctor — read-only installation, compatibility, and repository diagnostics.

set -u

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
STRICT=false
INSTALLED=false
ERRORS=0
WARNINGS=0

while (($# > 0)); do
    case "$1" in
        --strict) STRICT=true; shift ;;
        --installed) INSTALLED=true; shift ;;
        -h|--help)
            cat <<'EOF'
Aurora Doctor

Usage:
  ./aurora-doctor
  ./aurora-doctor --installed
  ./aurora-doctor --strict

The doctor never modifies Aurora.

The repository audit checks:
  - tracked/source file inventory;
  - broken local Markdown links;
  - obsolete host-specific references;
  - TODO/FIXME/deprecation markers;
  - backup/temporary artifacts;
  - runtime QML imports and singleton declarations;
  - documented runtime files against the current repository;
  - repository metadata and version consistency.
EOF
            exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
    esac
done

ok() { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
warn() { WARNINGS=$((WARNINGS + 1)); printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
fail() { ERRORS=$((ERRORS + 1)); printf '\033[1;31m[FAIL]\033[0m %s\n' "$*"; }
section() { printf '\n\033[1;35m%s\033[0m\n%s\n' "$1" '────────────────────────────────────────────'; }
require_file() {
    if [[ -f "$ROOT_DIR/$1" ]]; then
        ok "$1"
    else
        fail "Missing file: $1"
    fi
}

version_of() {
    "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
}

version_at_least() {
    [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" == "$2" ]]
}

repo_files() {
    if command -v git >/dev/null 2>&1 && git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "$ROOT_DIR" ls-files -co --exclude-standard
    else
        find "$ROOT_DIR" -type f -not -path '*/.git/*' -printf '%P\n'
    fi
}

is_text_file() {
    case "$1" in
        *.qml|*.js|*.mjs|*.sh|*.md|*.txt|*.json|*.ini|*.conf|*.toml|*.yaml|*.yml|*.xml|*.css|*.desktop|VERSION) return 0 ;;
        *) return 1 ;;
    esac
}

section "Aurora Doctor"
printf 'Path: %s\n' "$ROOT_DIR"
printf 'Mode: %s\n' "$([[ $INSTALLED == true ]] && echo installed || echo source)"

section "Runtime entrypoint"
for file in VERSION shell.qml install.sh aurora-doctor; do require_file "$file"; done
if grep -q 'ShellRoot' "$ROOT_DIR/shell.qml" && grep -q 'PanelWindow' "$ROOT_DIR/shell.qml"; then
    ok "shell.qml provides a standalone Quickshell window"
else
    fail "shell.qml is missing the standalone runtime root"
fi

section "Core structure"
for file in \
    Core/AuroraState.qml Core/AuroraConfig.qml Core/AuroraTheme.qml \
    Core/AuroraAnimations.qml Core/AuroraPluginRegistry.qml \
    Providers/AuroraMprisController.qml Providers/AuroraPlayerProvider.qml \
    Providers/AuroraAudioProvider.qml Providers/AuroraThemeProvider.qml \
    Providers/AuroraEqualizerProvider.qml \
    Components/Layout/AuroraPlayer.qml Components/Layout/AuroraBackground.qml \
    Components/Layout/AuroraCompactView.qml Components/Layout/AuroraHoverView.qml \
    Components/Layout/AuroraExpandedView.qml Components/AuroraControls.qml \
    Components/AuroraCover.qml Components/AuroraInfo.qml Components/AuroraSpectrum.qml \
    Components/AuroraPlayerSwitcher.qml Components/Media/AuroraBrowserBadge.qml \
    Assets/cava/raw_output_config.txt; do
    require_file "$file"
done

# AuroraAnimations is intentionally a host-independent QML singleton.
# Core remains free of qs.* host imports; the singleton uses QtQuick's
# standard pragma + QtObject form.
if grep -q '^pragma Singleton' "$ROOT_DIR/Core/AuroraAnimations.qml" \
    && grep -q '^QtObject {' "$ROOT_DIR/Core/AuroraAnimations.qml"; then
    ok "AuroraAnimations is a host-independent QML singleton"
else
    fail "AuroraAnimations is not declared as a valid host-independent singleton"
fi

section "Repository audit"
REPO_FILE_LIST="$(mktemp)"
trap 'rm -f "$REPO_FILE_LIST"' EXIT
repo_files > "$REPO_FILE_LIST"

TOTAL_FILES="$(wc -l < "$REPO_FILE_LIST")"
QML_FILES="$(grep -Ec '\.qml$' "$REPO_FILE_LIST" || true)"
DOC_FILES="$(grep -Ec '\.(md|txt)$' "$REPO_FILE_LIST" || true)"
SCRIPT_FILES="$(grep -Ec '\.(sh|py)$' "$REPO_FILE_LIST" || true)"
printf 'Files:       %s\n' "$TOTAL_FILES"
printf 'QML:         %s\n' "$QML_FILES"
printf 'Documentation:%s\n' "$DOC_FILES"
printf 'Scripts:     %s\n' "$SCRIPT_FILES"

# Runtime source directories are the authoritative implementation surface.
RUNTIME_DIRS=(Core Components Providers Themes Assets)
RUNTIME_IMPORT_ERROR=false
for dir in "${RUNTIME_DIRS[@]}"; do
    [[ -d "$ROOT_DIR/$dir" ]] || continue
    while IFS= read -r file; do
        if grep -Eq '^[[:space:]]*import[[:space:]]+qs(\.|[[:space:]])' "$file"; then
            fail "Host-specific qs.* import in runtime source: ${file#"$ROOT_DIR"/}"
            RUNTIME_IMPORT_ERROR=true
        fi
    done < <(find "$ROOT_DIR/$dir" -type f -name '*.qml' -print)
done
if ! $RUNTIME_IMPORT_ERROR; then
    ok "Runtime source is free of host-specific qs.* imports"
fi

# Known pre-standalone references. These are warnings in documentation/research,
# but failures inside active runtime code because they indicate an architectural regression.
LEGACY_PATTERNS=(
    'ii/modules/ii/mediaControls'
    'qs.modules.common'
    'root:/'
)
LEGACY_FOUND=false
for pattern in "${LEGACY_PATTERNS[@]}"; do
    while IFS= read -r file; do
        is_text_file "$file" || continue
        [[ -f "$ROOT_DIR/$file" ]] || continue
        if grep -Fq "$pattern" "$ROOT_DIR/$file"; then
            LEGACY_FOUND=true
            if [[ "$file" == Core/* || "$file" == Components/* || "$file" == Providers/* || "$file" == Themes/* || "$file" == shell.qml ]]; then
                fail "Obsolete runtime reference '$pattern' in $file"
            else
                warn "Historical/legacy reference '$pattern' remains in $file"
            fi
        fi
    done < "$REPO_FILE_LIST"
done
if ! $LEGACY_FOUND; then
    ok "No known obsolete architecture references found"
fi

# Detect actionable maintenance markers.
#
# A plain occurrence of words such as "obsolete" or "deprecated" is not
# sufficient to report a problem. They may legitimately appear in comments
# describing installer behavior, historical decisions, or the Doctor itself.
#
# Actionable markers must explicitly introduce unfinished maintenance work,
# for example:
#   TODO: replace deprecated API
#   FIXME: remove legacy provider
#   DEPRECATED: use AuroraAudioProvider
#   OBSOLETE: remove after migration
#
# Documentation and Doctor implementation are intentionally excluded because
# they describe the audit rules themselves.

MARKER_COUNT=0
MARKER_FILES=0

ACTIONABLE_MARKER_REGEX='^[[:space:]]*(//|#|/\*|\*)?[[:space:]]*(TODO|FIXME|DEPRECATED|OBSOLETE)[[:space:]]*[:!-]'

while IFS= read -r file; do
    is_text_file "$file" || continue
    [[ -f "$ROOT_DIR/$file" ]] || continue

    case "$file" in
        aurora-doctor|README.md|Blueprint/*.md|Research/*.md)
            continue
            ;;
    esac

    count="$(grep -Eic "$ACTIONABLE_MARKER_REGEX" \
        "$ROOT_DIR/$file" || true)"

    if (( count > 0 )); then
        MARKER_COUNT=$((MARKER_COUNT + count))
        MARKER_FILES=$((MARKER_FILES + 1))

        warn "Actionable maintenance marker(s) found in $file: $count"
    fi
done < "$REPO_FILE_LIST"

if (( MARKER_COUNT > 0 )); then
    warn "Found $MARKER_COUNT actionable maintenance marker(s) across $MARKER_FILES runtime file(s)"
else
    ok "No actionable maintenance markers found"
fi
# Backup and editor artifacts can make a repository appear to contain duplicate
# implementations and are especially dangerous in a Quickshell config directory.
ARTIFACTS="$(find "$ROOT_DIR" -type f \( -name '*~' -o -name '*.bak' -o -name '*.old' -o -name '*.orig' -o -name '*.rej' \) -not -path '*/.git/*' -print)"
if [[ -n "$ARTIFACTS" ]]; then
    warn "Backup/temporary artifacts found in repository: $(printf '%s\n' "$ARTIFACTS" | wc -l)"
    printf '%s\n' "$ARTIFACTS" | sed "s#^$ROOT_DIR/##" | head -n 10 | sed 's/^/      /'
else
    ok "No backup/temporary source artifacts found"
fi

# Every local Markdown link should resolve inside the repository. External URLs,
# anchors and mail links are intentionally ignored.
BROKEN_LINKS=0
while IFS= read -r file; do
    while IFS= read -r raw_link; do
        target="${raw_link#]\(}"
        target="${target%)}"
        target="${target%%#*}"
        target="${target%%\?*}"

        [[ -z "$target" || "$target" == \#* ]] && continue

        case "$target" in
            http://*|https://*|mailto:*|ftp://*)
                continue
                ;;
        esac

        [[ "$target" == /* ]] && continue

        base_dir="$(dirname "$file")"
        candidate="$ROOT_DIR/$base_dir/${target#./}"

        if [[ ! -e "$candidate" ]]; then
            BROKEN_LINKS=$((BROKEN_LINKS + 1))
            fail "Broken local documentation link: ${file#"$ROOT_DIR"/} -> $target"
        fi
    done < <(grep -oE '\]\([^)]*\)' "$file" || true)
done < <(
    find "$ROOT_DIR" -type f -name '*.md' -not -path '*/.git/*' \
        -printf '%P\n'
)

if (( BROKEN_LINKS == 0 )); then
    ok "Local Markdown links resolve"
fi
# Verify the documented provider/layout files against the actual repository.
DOC_REFERENCES=(
    'Blueprint/PROVIDERS.md'
    'Blueprint/THEMES.md'
    'Blueprint/STYLEGUIDE.md'
    'Blueprint/CHANGELOG.md'
    'Blueprint/ARCHITECTURE.md'
    'Blueprint/API.md'
    'Blueprint/INSTALL.md'
    'Blueprint/DECISIONS.md'
)
for file in "${DOC_REFERENCES[@]}"; do require_file "$file"; done

# Detect references to files that no longer exist in the runtime tree in the
# primary documentation. This is intentionally conservative: only explicit
# source paths with known Aurora extensions are checked.
STALE_RUNTIME_REFS=0
while IFS= read -r doc; do
    # shellcheck disable=SC2016
    while IFS= read -r ref; do
        ref="${ref#\`}"; ref="${ref%\`}"; ref="${ref#./}"
        case "$ref" in
            Core/*.qml|Components/*.qml|Providers/*.qml|Themes/*.qml|Assets/*)
                if [[ ! -e "$ROOT_DIR/$ref" ]]; then
                    STALE_RUNTIME_REFS=$((STALE_RUNTIME_REFS + 1))
                    fail "Documentation references missing runtime file: ${doc#"$ROOT_DIR"/} -> $ref"
                fi
                ;;
        esac
    done < <(grep -oE '`(Core|Components|Providers|Themes|Assets)/[^`[:space:]]+' "$doc" | sed 's/^`//' || true)
done < <(find "$ROOT_DIR/Blueprint" "$ROOT_DIR" -maxdepth 1 -type f -name '*.md' -print 2>/dev/null | sort -u)
if (( STALE_RUNTIME_REFS == 0 )); then
    ok "Primary documentation contains no missing runtime file references"
fi

# Repository metadata and version consistency.
if command -v git >/dev/null 2>&1 && git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$ROOT_DIR" diff --quiet --ignore-submodules -- .; then
        ok "Git working tree has no tracked content changes"
    else
        warn "Git working tree contains tracked content changes"
    fi
    if git -C "$ROOT_DIR" diff --quiet --cached --ignore-submodules -- .; then
        ok "Git index has no staged content changes"
    else
        warn "Git index contains staged content changes"
    fi
    BRANCH="$(git -C "$ROOT_DIR" branch --show-current 2>/dev/null || true)"
    if [[ -n "$BRANCH" ]]; then
        printf 'Branch:      %s\n' "$BRANCH"
    fi
else
    warn "Git metadata unavailable; repository state checks skipped"
fi

if [[ -f "$ROOT_DIR/VERSION" ]]; then
    VERSION="$(tr -d '[:space:]' < "$ROOT_DIR/VERSION")"
    if [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]]; then
        ok "VERSION format is valid: $VERSION"
    else
        fail "VERSION contains an invalid semantic version: $VERSION"
    fi
fi

section "Host isolation"
HOST_IMPORTS=false
while IFS= read -r file; do
    if grep -Eq '^[[:space:]]*import[[:space:]]+qs(\.|[[:space:]])' "$file"; then
        fail "Host-specific import found: ${file#"$ROOT_DIR"/}"
        HOST_IMPORTS=true
    fi
done < <(find "$ROOT_DIR/Core" "$ROOT_DIR/Components" "$ROOT_DIR/Providers" -type f -name '*.qml' -print)
if $HOST_IMPORTS; then
    :
else
    ok "Core, Components and Providers do not import qs.* host modules"
fi

if grep -q 'Quickshell.Services.Mpris' "$ROOT_DIR/Providers/AuroraMprisController.qml"; then
    ok "MPRIS uses Quickshell's official service API"
else
    fail "AuroraMprisController is not using Quickshell.Services.Mpris"
fi

section "Quickshell"
if command -v qs >/dev/null 2>&1; then QS_CMD=qs
elif command -v quickshell >/dev/null 2>&1; then QS_CMD=quickshell
else fail "Quickshell executable not found (qs/quickshell)"; QS_CMD=""; fi

if [[ -n "$QS_CMD" ]]; then
    QS_VERSION="$(version_of "$QS_CMD")"
    if [[ -n "$QS_VERSION" ]]; then
        printf 'Detected: %s %s\n' "$QS_CMD" "$QS_VERSION"
        if version_at_least "$QS_VERSION" "0.2.0"; then ok "Quickshell version is supported (>= 0.2.0)"; else fail "Quickshell $QS_VERSION is too old; Aurora requires >= 0.2.0"; fi
    else
        warn "Quickshell version could not be parsed"
    fi
fi

section "Media"
if command -v cava >/dev/null 2>&1; then ok "Cava available — spectrum enabled"; else warn "Cava not installed — spectrum uses fallback/idle behavior"; fi
if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then ok "D-Bus session detected — MPRIS can be queried"; else warn "No D-Bus session detected"; fi
if command -v pactl >/dev/null 2>&1 || command -v pw-cli >/dev/null 2>&1; then ok "Audio session tooling detected"; else warn "PipeWire/PulseAudio CLI tooling not detected"; fi

section "Environment"
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then ok "Wayland session detected"; elif [[ -n "${DISPLAY:-}" ]]; then ok "X11 session detected"; else warn "No Wayland/X11 display environment detected"; fi
for wm in Hyprland sway i3; do if pgrep -x "$wm" >/dev/null 2>&1; then ok "Detected compositor/window manager: $wm"; fi; done

section "Installer"
if [[ -x "$ROOT_DIR/install.sh" ]]; then
    ok "install.sh is executable"
else
    fail "install.sh is not executable"
fi
if bash -n "$ROOT_DIR/install.sh"; then ok "install.sh syntax is valid"; else fail "install.sh has shell syntax errors"; fi
if command -v shellcheck >/dev/null 2>&1; then
    if shellcheck "$ROOT_DIR/install.sh" "$ROOT_DIR/aurora-doctor"; then
        ok "Shell scripts pass shellcheck"
    else
        fail "Shellcheck reported errors"
    fi
else
    warn "shellcheck not installed; shell lint skipped"
fi

section "Plugins"
PLUGIN_BASE="${XDG_CONFIG_HOME:-${HOME}/.config}/aurora/plugins"
if [[ -d "$PLUGIN_BASE" ]]; then ok "External plugin directory: $PLUGIN_BASE"; else warn "External plugin directory not created yet: $PLUGIN_BASE"; fi

section "Blueprint"
for file in Blueprint/README.md Blueprint/ARCHITECTURE.md Blueprint/INSTALL.md Blueprint/API.md Blueprint/DECISIONS.md; do require_file "$file"; done
OBSOLETE=false
for file in Blueprint/README.md Blueprint/ARCHITECTURE.md Blueprint/INSTALL.md Blueprint/API.md; do
    if grep -Eqs 'ii/modules/ii/mediaControls|qs\.services|qs\.modules\.common' "$ROOT_DIR/$file"; then
        fail "Obsolete host-specific reference in $file"
        OBSOLETE=true
    fi
done
if $OBSOLETE; then
    :
else
    ok "Current Blueprint documents match standalone architecture"
fi

section "Summary"
printf 'Errors:   %d\nWarnings: %d\n' "$ERRORS" "$WARNINGS"
if (( ERRORS > 0 )); then printf '\n\033[1;31mAurora is not ready.\033[0m\n'; exit 1; fi
if $STRICT && (( WARNINGS > 0 )); then printf '\n\033[1;31mStrict mode: warnings are treated as errors.\033[0m\n'; exit 1; fi
if (( WARNINGS > 0 )); then printf '\n\033[1;33mAurora is ready with optional warnings.\033[0m\n'; else printf '\n\033[1;32mAurora is ready.\033[0m\n'; fi
