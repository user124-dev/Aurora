#!/usr/bin/env bash
# Aurora Doctor — read-only diagnostics for source and installed trees.
set -u
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
STRICT=false
INSTALLED=false
ERRORS=0
WARNINGS=0

while (($#)); do
  case "$1" in
    --strict) STRICT=true; shift;;
    --installed) INSTALLED=true; shift;;
    -h|--help) printf '%s\n' 'Usage: ./aurora-doctor [--installed] [--strict]'; exit 0;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2;;
  esac
done
ok(){ printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
warn(){ WARNINGS=$((WARNINGS+1)); printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
fail(){ ERRORS=$((ERRORS+1)); printf '\033[1;31m[FAIL]\033[0m %s\n' "$*"; }
section(){ printf '\n\033[1;35m%s\033[0m\n%s\n' "$1" '────────────────────────────────────────────'; }
require_file(){
  if [[ -f "$ROOT_DIR/$1" ]]; then ok "$1"; else fail "Missing file: $1"; fi
}
repo_files(){
  if git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$ROOT_DIR" ls-files -co --exclude-standard
  else
    find "$ROOT_DIR" -type f -not -path '*/.git/*' -printf '%P\n'
  fi
}
is_text(){ case "$1" in *.qml|*.js|*.mjs|*.sh|*.md|*.txt|*.json|*.yml|*.yaml|VERSION) return 0;; *) return 1;; esac; }

section 'Aurora Doctor'
if [[ $INSTALLED == true ]]; then MODE=installed; else MODE=source; fi
printf 'Path: %s\nMode: %s\n' "$ROOT_DIR" "$MODE"

section 'Runtime entrypoint'
for f in VERSION shell.qml install.sh aurora-doctor; do require_file "$f"; done
if grep -q 'ShellRoot' "$ROOT_DIR/shell.qml" && grep -q 'PanelWindow' "$ROOT_DIR/shell.qml"; then ok 'shell.qml provides a standalone Quickshell window'; else fail 'shell.qml is missing the standalone runtime root'; fi

section 'Core structure'
for f in \
  Core/AuroraState.qml Core/AuroraConfig.qml Core/AuroraTheme.qml Core/AuroraAnimations.qml Core/AuroraPluginRegistry.qml \
  Providers/AuroraMprisController.qml Providers/AuroraPlayerProvider.qml Providers/AuroraAudioProvider.qml Providers/AuroraPipewireProvider.qml Providers/AuroraThemeProvider.qml Providers/AuroraEqualizerProvider.qml Providers/AuroraLyricsProvider.qml \
  Components/Layout/AuroraPlayer.qml Components/Layout/AuroraBackground.qml Components/Layout/AuroraCompactView.qml Components/Layout/AuroraHoverView.qml Components/Layout/AuroraExpandedView.qml \
  Components/AuroraControls.qml Components/AuroraCover.qml Components/AuroraInfo.qml Components/AuroraSpectrum.qml Components/AuroraPlayerSwitcher.qml Components/AuroraEqualizerSwitcher.qml Components/AuroraLyricsPanel.qml Components/AuroraSessionPanel.qml Components/Media/AuroraBrowserBadge.qml \
  Session/AuroraSessionQueue.qml Assets/cava/raw_output_config.txt; do require_file "$f"; done
if grep -q '^pragma Singleton' "$ROOT_DIR/Core/AuroraAnimations.qml" && grep -q '^QtObject {' "$ROOT_DIR/Core/AuroraAnimations.qml"; then ok 'AuroraAnimations is a host-independent QML singleton'; else fail 'AuroraAnimations singleton declaration is invalid'; fi

section 'Repository audit'
LIST="$(mktemp)"
trap 'rm -f "$LIST"' EXIT
repo_files > "$LIST"
printf 'Files:       %s\nQML:         %s\nDocumentation:%s\nScripts:     %s\n' \
  "$(wc -l < "$LIST")" "$(grep -Ec '\.qml$' "$LIST" || true)" "$(grep -Ec '\.(md|txt)$' "$LIST" || true)" "$(grep -Ec '\.(sh|py)$' "$LIST" || true)"

RUNTIME_IMPORT_ERROR=false
for dir in Core Components Providers Session Themes Assets; do
  [[ -d "$ROOT_DIR/$dir" ]] || continue
  while IFS= read -r file; do
    if grep -Eq '^[[:space:]]*import[[:space:]]+qs(\.|[[:space:]])' "$file"; then
      fail "Host-specific qs.* import in runtime source: ${file#"$ROOT_DIR"/}"
      RUNTIME_IMPORT_ERROR=true
    fi
  done < <(find "$ROOT_DIR/$dir" -type f -name '*.qml' -print)
done
if [[ $RUNTIME_IMPORT_ERROR == false ]]; then ok 'Runtime source is free of host-specific qs.* imports'; fi

LEGACY_FOUND=false
while IFS= read -r file; do
  is_text "$file" || continue
  [[ -f "$ROOT_DIR/$file" ]] || continue
  for pattern in 'ii/modules/ii/mediaControls' 'qs.modules.common' 'root:/'; do
    grep -Fq "$pattern" "$ROOT_DIR/$file" || continue
    case "$file" in
      Core/*|Components/*|Providers/*|Session/*|Themes/*|shell.qml)
        fail "Obsolete runtime reference '$pattern' in $file"
        LEGACY_FOUND=true;;
      Research/*|Blueprint/DECISIONS.md|Blueprint/CHANGELOG.md)
        :;;
      *)
        warn "Legacy reference '$pattern' in $file; verify that it is explicitly historical or a negative rule";;
    esac
  done
done < "$LIST"
if [[ $LEGACY_FOUND == false ]]; then ok 'No obsolete legacy references in runtime source'; fi

ARTIFACTS="$(find "$ROOT_DIR" -type f \( -name '*~' -o -name '*.bak' -o -name '*.old' -o -name '*.orig' -o -name '*.rej' \) -not -path '*/.git/*' -print)"
if [[ -z "$ARTIFACTS" ]]; then
  ok 'No backup/temporary source artifacts found'
else
  warn "Backup/temporary artifacts found: $(printf '%s\n' "$ARTIFACTS" | wc -l)"
fi

BROKEN=0
while IFS= read -r file; do
  while IFS= read -r raw; do
    target="${raw#]\(}"; target="${target%)}"; target="${target%%#*}"; target="${target%%\?*}"
    [[ -z "$target" || "$target" == \#* ]] && continue
    case "$target" in http://*|https://*|mailto:*|ftp://*) continue;; esac
    [[ "$target" == /* ]] && continue
    [[ "$target" == *'<'*'>'* || "$target" == *'*'* ]] && continue
    candidate="$(dirname -- "$file")/${target#./}"
    if [[ ! -e "$candidate" ]]; then
      BROKEN=$((BROKEN+1))
      fail "Broken local documentation link: ${file#"$ROOT_DIR"/} -> $target"
    fi
  done < <(grep -oE '\]\([^)]*\)' "$file" || true)
done < <(find "$ROOT_DIR" -type f -name '*.md' -not -path '*/.git/*' -print)
if (( BROKEN == 0 )); then ok 'Local Markdown links resolve'; fi

section 'Blueprint'
for f in Blueprint/README.md Blueprint/ARCHITECTURE.md Blueprint/INSTALL.md Blueprint/API.md Blueprint/DECISIONS.md Blueprint/DECISIONS_CURRENT.md Blueprint/DATAFLOW.md Blueprint/PROVIDERS.md Blueprint/THEMES.md Blueprint/STYLEGUIDE.md Blueprint/CHANGELOG.md; do require_file "$f"; done

STALE=0
while IFS= read -r doc; do
  while IFS= read -r ref; do
    ref="${ref#\`}"; ref="${ref%\`}"; ref="${ref#./}"
    [[ "$ref" == *'<'*'>'* || "$ref" == *'*'* ]] && continue
    [[ "$ref" == "Themes/Default/Theme.qml" ]] && continue
    case "$ref" in Core/*.qml|Components/*.qml|Providers/*.qml|Session/*.qml|Themes/*.json|Assets/*)
      if [[ ! -e "$ROOT_DIR/$ref" ]]; then
        STALE=$((STALE+1))
        fail "Documentation references missing runtime file: ${doc#"$ROOT_DIR"/} -> $ref"
      fi;;
    esac
  done < <(grep -oE '`(Core|Components|Providers|Session|Themes|Assets)/[^`[:space:]]+' "$doc" | sed 's/^`//' || true)
done < <(find "$ROOT_DIR/Blueprint" -maxdepth 1 -type f -name '*.md' -print)
if (( STALE == 0 )); then ok 'Primary documentation contains no missing runtime file references'; fi

section 'Host isolation'
if grep -q 'Quickshell.Services.Mpris' "$ROOT_DIR/Providers/AuroraMprisController.qml"; then ok "MPRIS uses Quickshell's official service API"; else fail 'AuroraMprisController is not using Quickshell.Services.Mpris'; fi
if grep -q 'Quickshell.Services.Pipewire' "$ROOT_DIR/Providers/AuroraPipewireProvider.qml"; then ok "PipeWire uses Quickshell's official service API"; else fail 'AuroraPipewireProvider is not using Quickshell.Services.Pipewire'; fi

section 'Quickshell'
if command -v qs >/dev/null 2>&1; then
  QS_VERSION="$(qs --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
  if [[ -n "$QS_VERSION" ]]; then printf 'Detected: qs %s\n' "$QS_VERSION"; else warn 'Quickshell version could not be parsed'; fi
else
  warn 'Quickshell executable not found (qs)'
fi

section 'Media'
if command -v cava >/dev/null 2>&1; then ok 'Cava available — spectrum enabled'; else warn 'Cava not installed — spectrum uses fallback/idle behavior'; fi
if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then ok 'D-Bus session detected — MPRIS can be queried'; else warn 'No D-Bus session detected'; fi
if command -v pw-cli >/dev/null 2>&1 || command -v wpctl >/dev/null 2>&1 || command -v pipewire >/dev/null 2>&1; then ok 'PipeWire tooling detected'; else warn 'PipeWire CLI tooling not detected; Quickshell PipeWire API may still be available'; fi
if command -v easyeffects >/dev/null 2>&1; then ok 'EasyEffects detected — effects integration available'; else warn 'EasyEffects not installed — equalizer/effects features remain optional'; fi
if command -v curl >/dev/null 2>&1; then ok 'curl detected — remote covers/lyrics available'; else warn 'curl not installed — remote covers/lyrics are unavailable'; fi

section 'Environment'
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then ok 'Wayland session detected'; else warn 'Wayland session not detected'; fi
for wm in Hyprland sway i3; do
  if pgrep -x "$wm" >/dev/null 2>&1; then ok "Detected compositor/window manager: $wm"; fi
done

section 'Installer'
if [[ -x "$ROOT_DIR/install.sh" ]]; then ok 'install.sh is executable'; else fail 'install.sh is not executable'; fi
if bash -n "$ROOT_DIR/install.sh"; then ok 'install.sh syntax is valid'; else fail 'install.sh has shell syntax errors'; fi
if bash -n "$ROOT_DIR/aurora-doctor"; then ok 'aurora-doctor syntax is valid'; else fail 'aurora-doctor has shell syntax errors'; fi
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck "$ROOT_DIR/install.sh" "$ROOT_DIR/aurora-doctor" "$ROOT_DIR/aurora-theme"; then
    ok 'Shell scripts pass shellcheck'
  else
    fail 'Shellcheck reported errors'
  fi
else
  warn 'shellcheck not installed; shell lint skipped'
fi

section 'Plugins / extensions'
PLUGIN_BASE="${XDG_CONFIG_HOME:-${HOME}/.config}/aurora/plugins"
if [[ -d "$PLUGIN_BASE" ]]; then ok "External plugin directory: $PLUGIN_BASE"; else ok "External plugin directory will be created on demand: $PLUGIN_BASE"; fi
if [[ -d "$ROOT_DIR/Providers/Sources" ]]; then ok 'Source-provider extension point exists: Providers/Sources'; else warn 'Source-provider extension point is missing'; fi

section 'Autostart'
AUTOSTART_FILE="$ROOT_DIR/aurora-autostart.desktop"
if [[ -f "$AUTOSTART_FILE" ]]; then
  ok 'Aurora desktop autostart definition exists'
else
  fail 'Aurora desktop autostart definition is missing'
fi
if [[ $INSTALLED == true ]]; then
  USER_AUTOSTART="${XDG_CONFIG_HOME:-${HOME}/.config}/autostart/aurora.desktop"
  if [[ -f "$USER_AUTOSTART" ]]; then ok 'Aurora is registered for graphical-session autostart'; else fail 'Aurora is not registered for graphical-session autostart'; fi
fi

if [[ -f "$ROOT_DIR/VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "$ROOT_DIR/VERSION")"
  if [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]]; then ok "VERSION format is valid: $VERSION"; else fail "VERSION contains an invalid semantic version: $VERSION"; fi
fi

section 'Summary'
printf 'Errors:   %s\nWarnings: %s\n' "$ERRORS" "$WARNINGS"
if (( ERRORS > 0 )); then printf '%s\n' 'Aurora is not ready.'; exit 1; fi
if $STRICT && (( WARNINGS > 0 )); then printf '%s\n' 'Aurora passed functional checks but strict mode rejects warnings.'; exit 1; fi
printf '%s\n' 'Aurora is ready with optional warnings.'
exit 0
