#!/usr/bin/env bash
# Aurora Doctor — read-only installation and compatibility diagnostics.

set -u

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
STRICT=false
INSTALLED=false
ERRORS=0
WARNINGS=0

while (($# > 0)); do
    case "$1" in
        --strict) STRICT=true; shift ;;
        --installed) INSTALLED=true; shift ;;
        -h|--help)
            cat <<'EOF'
Aurora Doctor

Usage:
  ./aurora-doctor
  ./aurora-doctor --installed
  ./aurora-doctor --strict

The doctor never modifies Aurora.
EOF
            exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
    esac
done

ok() { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
warn() { WARNINGS=$((WARNINGS + 1)); printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
fail() { ERRORS=$((ERRORS + 1)); printf '\033[1;31m[FAIL]\033[0m %s\n' "$*"; }
section() { printf '\n\033[1;35m%s\033[0m\n%s\n' "$1" '────────────────────────────────────────────'; }
require_file() {
    if [[ -f "$ROOT_DIR/$1" ]]; then
        ok "$1"
    else
        fail "Missing file: $1"
    fi
}

version_of() {
    "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
}

version_at_least() {
    [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" == "$2" ]]
}

section "Aurora Doctor"
printf 'Path: %s\n' "$ROOT_DIR"
printf 'Mode: %s\n' "$([[ $INSTALLED == true ]] && echo installed || echo source)"

section "Runtime entrypoint"
for file in VERSION shell.qml install.sh aurora-doctor; do require_file "$file"; done
if grep -q 'ShellRoot' "$ROOT_DIR/shell.qml" && grep -q 'PanelWindow' "$ROOT_DIR/shell.qml"; then
    ok "shell.qml provides a standalone Quickshell window"
else
    fail "shell.qml is missing the standalone runtime root"
fi

section "Core structure"
for file in \
    Core/AuroraState.qml Core/AuroraConfig.qml Core/AuroraTheme.qml \
    Core/AuroraAnimations.qml Core/AuroraPluginRegistry.qml \
    Providers/AuroraMprisController.qml Providers/AuroraPlayerProvider.qml \
    Providers/AuroraAudioProvider.qml Providers/AuroraThemeProvider.qml \
    Components/Layout/AuroraPlayer.qml Components/Layout/AuroraBackground.qml \
    Components/Layout/AuroraCompactView.qml Components/Layout/AuroraHoverView.qml \
    Components/Layout/AuroraExpandedView.qml Components/AuroraControls.qml \
    Components/AuroraCover.qml Components/AuroraInfo.qml Components/AuroraSpectrum.qml \
    Components/AuroraPlayerSwitcher.qml Components/Media/AuroraBrowserBadge.qml \
    Assets/cava/raw_output_config.txt; do
    require_file "$file"
done

# Catch the class of runtime warning that previously escaped the doctor:
# a pragma Singleton must use Quickshell's Singleton root type.
if grep -q '^pragma Singleton' "$ROOT_DIR/Core/AuroraAnimations.qml" && grep -q '^Singleton {' "$ROOT_DIR/Core/AuroraAnimations.qml"; then
    ok "AuroraAnimations uses Quickshell's Singleton root"
else
    fail "AuroraAnimations is not declared as a valid Quickshell singleton"
fi

section "Host isolation"
HOST_IMPORTS=false
while IFS= read -r file; do
    if grep -Eq '^[[:space:]]*import[[:space:]]+qs(\.|[[:space:]])' "$file"; then
        fail "Host-specific import found: ${file#"$ROOT_DIR"/}"
        HOST_IMPORTS=true
    fi
done < <(find "$ROOT_DIR/Core" "$ROOT_DIR/Components" "$ROOT_DIR/Providers" -type f -name '*.qml' -print)
if $HOST_IMPORTS; then
    :
else
    ok "Core, Components and Providers do not import qs.* host modules"
fi

if grep -q 'Quickshell.Services.Mpris' "$ROOT_DIR/Providers/AuroraMprisController.qml"; then
    ok "MPRIS uses Quickshell's official service API"
else
    fail "AuroraMprisController is not using Quickshell.Services.Mpris"
fi

section "Quickshell"
if command -v qs >/dev/null 2>&1; then QS_CMD=qs
elif command -v quickshell >/dev/null 2>&1; then QS_CMD=quickshell
else fail "Quickshell executable not found (qs/quickshell)"; QS_CMD=""; fi

if [[ -n "$QS_CMD" ]]; then
    QS_VERSION="$(version_of "$QS_CMD")"
    if [[ -n "$QS_VERSION" ]]; then
        printf 'Detected: %s %s\n' "$QS_CMD" "$QS_VERSION"
        if version_at_least "$QS_VERSION" "0.2.0"; then ok "Quickshell version is supported (>= 0.2.0)"; else fail "Quickshell $QS_VERSION is too old; Aurora requires >= 0.2.0"; fi
    else
        warn "Quickshell version could not be parsed"
    fi
fi

section "Media"
if command -v cava >/dev/null 2>&1; then ok "Cava available — spectrum enabled"; else warn "Cava not installed — spectrum uses fallback/idle behavior"; fi
if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then ok "D-Bus session detected — MPRIS can be queried"; else warn "No D-Bus session detected"; fi
if command -v pactl >/dev/null 2>&1 || command -v pw-cli >/dev/null 2>&1; then ok "Audio session tooling detected"; else warn "PipeWire/PulseAudio CLI tooling not detected"; fi

section "Environment"
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then ok "Wayland session detected"; elif [[ -n "${DISPLAY:-}" ]]; then ok "X11 session detected"; else warn "No Wayland/X11 display environment detected"; fi
for wm in Hyprland sway i3; do if pgrep -x "$wm" >/dev/null 2>&1; then ok "Detected compositor/window manager: $wm"; fi; done

section "Installer"
if [[ -x "$ROOT_DIR/install.sh" ]]; then
    ok "install.sh is executable"
else
    fail "install.sh is not executable"
fi
if bash -n "$ROOT_DIR/install.sh"; then ok "install.sh syntax is valid"; else fail "install.sh has shell syntax errors"; fi
if command -v shellcheck >/dev/null 2>&1; then
    if shellcheck "$ROOT_DIR/install.sh" "$ROOT_DIR/aurora-doctor"; then
        ok "Shell scripts pass shellcheck"
    else
        fail "Shellcheck reported errors"
    fi
else
    warn "shellcheck not installed; shell lint skipped"
fi

section "Plugins"
PLUGIN_BASE="${XDG_CONFIG_HOME:-${HOME}/.config}/aurora/plugins"
if [[ -d "$PLUGIN_BASE" ]]; then ok "External plugin directory: $PLUGIN_BASE"; else warn "External plugin directory not created yet: $PLUGIN_BASE"; fi

section "Blueprint"
for file in Blueprint/README.md Blueprint/ARCHITECTURE.md Blueprint/INSTALL.md Blueprint/API.md Blueprint/DECISIONS.md; do require_file "$file"; done
OBSOLETE=false
for file in Blueprint/README.md Blueprint/ARCHITECTURE.md Blueprint/INSTALL.md Blueprint/API.md; do
    if grep -Eqs 'ii/modules/ii/mediaControls|qs\.services|qs\.modules\.common' "$ROOT_DIR/$file"; then
        fail "Obsolete host-specific reference in $file"
        OBSOLETE=true
    fi
done
if $OBSOLETE; then
    :
else
    ok "Current Blueprint documents match standalone architecture"
fi

section "Summary"
printf 'Errors:   %d\nWarnings: %d\n' "$ERRORS" "$WARNINGS"
if (( ERRORS > 0 )); then printf '\n\033[1;31mAurora is not ready.\033[0m\n'; exit 1; fi
if $STRICT && (( WARNINGS > 0 )); then printf '\n\033[1;31mStrict mode: warnings are treated as errors.\033[0m\n'; exit 1; fi
if (( WARNINGS > 0 )); then printf '\n\033[1;33mAurora is ready with optional warnings.\033[0m\n'; else printf '\n\033[1;32mAurora is ready.\033[0m\n'; fi
