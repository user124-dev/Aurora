#!/usr/bin/env bash
# Aurora theme selector. Theme definitions live in the repository Themes/ tree;
# the selection is persisted outside the runtime tree in one file with two
# independent fields: "name" (the palette) and "background" (what is drawn
# behind the widget: aurora, custom or wallpaper).

set -u

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEMES_DIR="$SCRIPT_DIR/Themes"
CONFIG_BASE="${XDG_CONFIG_HOME:-${HOME}/.config}"
THEME_DIR="${CONFIG_BASE%/}/aurora"
THEME_FILE="$THEME_DIR/theme.json"

usage() {
    cat <<'EOF'
Aurora Theme

Usage:
  aurora-theme list
  aurora-theme current
  aurora-theme set <theme>
  aurora-theme use <theme>   (alias of 'set')
  aurora-theme reset
  aurora-theme background list
  aurora-theme background current
  aurora-theme background set <aurora|wallpaper|custom> [path]

Theme definitions are read from Aurora/Themes/*.json.
'set' and 'reset' change the palette only; the background mode is kept.
The wallpaper background needs one of: hyprpaper (hyprctl), swww, or GNOME
(gsettings). Without one, Aurora falls back to its default background.
The custom background uses an image path stored in theme.json.
EOF
}

list_themes() {
    local file name found=0
    shopt -s nullglob
    for file in "$THEMES_DIR"/*.json; do
        name="$(basename "$file" .json)"
        printf '%s\n' "$name"
        found=1
    done
    shopt -u nullglob
    if [[ "$found" -eq 0 ]]; then
        printf 'aurora\n'
    fi
}

is_valid() {
    [[ -f "$THEMES_DIR/$1.json" ]]
}

BACKGROUND_MODES=(aurora wallpaper custom)

is_valid_background() {
    local mode
    for mode in "${BACKGROUND_MODES[@]}"; do
        [[ "$mode" == "$1" ]] && return 0
    done
    return 1
}

# read_field <field> <default> - prints the string value of a top-level key
# in theme.json, or the default when the file or the key is missing.
read_field() {
    local field="$1" default="$2" value=""
    if [[ -f "$THEME_FILE" ]]; then
        value="$(sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$THEME_FILE" | head -n1)"
    fi
    printf '%s\n' "${value:-$default}"
}

# write_selection <name> <background> [backgroundPath] - always writes both
# axes and keeps a path only for the custom background.
write_selection() {
    local name="$1" background="$2" background_path="${3:-}"
    mkdir -p "$THEME_DIR"
    if [[ "$background" == "custom" ]]; then
        printf '{"name":"%s","background":"%s","backgroundPath":"%s"}\n' \
            "$name" "$background" "$background_path" > "$THEME_FILE"
    else
        printf '{"name":"%s","background":"%s","backgroundPath":""}\n' \
            "$name" "$background" > "$THEME_FILE"
    fi
}

choose_custom_path() {
    local path="${1:-}"
    if [[ -z "$path" ]]; then
        read -r -p 'Ruta de la imagen personalizada: ' path
    fi
    if [[ -z "$path" ]]; then
        printf 'Debes indicar la ruta de una imagen.\n' >&2
        exit 2
    fi
    if [[ "$path" == ~/* ]]; then
        path="${HOME}${path#~}"
    fi
    if [[ ! -f "$path" ]]; then
        printf 'La imagen no existe o no es un archivo: %s\n' "$path" >&2
        exit 2
    fi
    printf '%s\n' "$path"
}

case "${1:-}" in
    list)
        list_themes
        ;;
    current)
        if [[ -f "$THEME_FILE" ]]; then
            sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$THEME_FILE" | head -n1
        else
            printf '%s\n' aurora
        fi
        ;;
    set|use)
        if [[ -z "${2:-}" ]] || ! is_valid "$2"; then
            printf 'Tema inválido. Usa uno de: ' >&2
            list_themes | tr '\n' ' ' >&2
            printf '\n' >&2
            exit 2
        fi
        write_selection "$2" "$(read_field background aurora)" "$(read_field backgroundPath '')"
        printf 'Aurora theme: %s\n' "$2"
        ;;
    reset)
        write_selection aurora "$(read_field background aurora)" "$(read_field backgroundPath '')"
        printf 'Aurora theme: aurora\n'
        ;;
    background)
        case "${2:-}" in
            list)
                printf '%s\n' "${BACKGROUND_MODES[@]}"
                ;;
            current)
                read_field background aurora
                ;;
            set)
                if [[ "${3:-}" == "system" ]]; then
                    printf 'El modo "system" fue renombrado a "custom".\n' >&2
                    exit 2
                fi
                if [[ "${3:-}" == "custom" ]]; then
                    custom_path="$(choose_custom_path "${4:-}")"
                    write_selection "$(read_field name aurora)" custom "$custom_path"
                    printf 'Aurora background: custom\n'
                    printf 'Aurora background path: %s\n' "$custom_path"
                    exit 0
                fi
                if [[ -z "${3:-}" ]] || ! is_valid_background "$3"; then
                    printf 'Fondo inválido. Usa uno de: %s\n' "${BACKGROUND_MODES[*]}" >&2
                    exit 2
                fi
                write_selection "$(read_field name aurora)" "$3"
                printf 'Aurora background: %s\n' "$3"
                ;;
            *)
                printf 'Uso: aurora-theme background <list|current|set <modo> [path]>\n' >&2
                exit 2
                ;;
        esac
        ;;
    -h|--help|"")
        usage
        ;;
    *)
        printf 'Opción desconocida: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
